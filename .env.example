# 运行配置
DOMAIN=house
DATA_SOURCE=mock
MOCK_ROWS=300

# Flask
FLASK_SECRET_KEY=replace-with-random-string
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace-with-password
DB_NAME=housinginfo
DB_CHARSET=utf8mb4

# 定时采集（true 开启；间隔单位秒，演示 30 / 采集 3600）
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL=30

# 大模型对话（DeepSeek）
DEEPSEEK_API_KEY=replace-with-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
